Heaviside_step_function <- function(x){
if(x<0) return(0)
return(1)
}
Heaviside_step_function(0)
Heaviside_step_function(2)
Heaviside_step_function(0)
Heaviside_step_function(-1)
Heaviside_step_function(1)
Heaviside_step_function(0)
